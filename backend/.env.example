# Copy this file to .env and fill in your real values. Never commit the real .env file.

PORT=3001

# MongoDB Atlas connection string (from your existing cluster)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/fitcheck?retryWrites=true&w=majority

# Any long random string - used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Cloudinary (free account at cloudinary.com) - for storing uploaded photos
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# URL of the Python AI service (local for now, Render URL once deployed)
AI_SERVICE_URL=http://localhost:8000

# Generative AI - get a free key from https://aistudio.google.com/app/apikey (Gemini free tier)
GEMINI_API_KEY=your_gemini_key
