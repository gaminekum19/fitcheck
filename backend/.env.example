# Copy to .env and fill in. Never commit .env.
PORT=3001
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/fitcheck?retryWrites=true&w=majority

# Long random string (16+ characters). The server refuses to start without one.
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL of the AI service (local, or your Hugging Face Space URL once deployed)
AI_SERVICE_URL=http://localhost:8000
# Shared secret so only this backend can call the AI service. Same value on both sides. Leave empty locally.
AI_SERVICE_KEY=

# Production: your website address, so other sites can't call the API from a browser
CORS_ORIGIN=
# The only account allowed to add products. Use the email you signed up with.
ADMIN_EMAIL=

# Optional: free Gemini key for AI-written explanations
GEMINI_API_KEY=
